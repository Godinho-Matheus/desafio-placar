# Exemplo de variaveis de ambiente para execucao local com Docker Compose.
#
# Copie para ".env" e ajuste se necessario:
#   cp .env.example .env
#
# Os valores abaixo sao defaults EXPLICITAMENTE destinados ao desenvolvimento
# local. NAO use estas credenciais em qualquer ambiente real.

# --- PostgreSQL ---
# Consumido pelo container postgres e pelo Payara (para gerar o Connection Pool
# jdbc/placar). A aplicacao nunca recebe estes valores diretamente.
POSTGRES_DB=placar
POSTGRES_USER=placar
POSTGRES_PASSWORD=placar_dev

# --- RabbitMQ ---
# Usuario/senha do broker. A aplicacao recebe os mesmos valores via
# RABBITMQ_USERNAME/RABBITMQ_PASSWORD (definidos no compose.yaml).
RABBITMQ_DEFAULT_USER=placar
RABBITMQ_DEFAULT_PASS=placar_dev

# --- Portas publicadas no host ---
# Apenas as portas expostas no host sao configuraveis (as portas internas dos
# containers sao fixas). Ajuste estes valores se houver conflito de porta na
# sua maquina. Os defaults sao os valores padrao da execucao.
APP_PORT=8080
PAYARA_ADMIN_PORT=4848
RABBITMQ_MANAGEMENT_PORT=15672
