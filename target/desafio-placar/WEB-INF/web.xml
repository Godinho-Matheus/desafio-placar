<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Desafio Placar</display-name>

    <!--
        Filtro do Apache Wicket que serve a Interface_Web.
        Mapeado em /* (padrao do Wicket): requisicoes nao reconhecidas pelo Wicket
        seguem o filter chain do container, de modo que os recursos estaticos
        (/swagger/, /webjars/) e outros artefatos continuam funcionando. A API
        JAX-RS fica em /api (tratada pelo servidor) e o documento OpenAPI em
        /openapi (fora deste contexto de WAR), ambos nao afetados.
    -->
    <filter>
        <filter-name>WicketFilter</filter-name>
        <filter-class>org.apache.wicket.protocol.http.WicketFilter</filter-class>
        <init-param>
            <param-name>applicationClassName</param-name>
            <param-value>com.desafio.placar.web.PlacarWebApplication</param-value>
        </init-param>
        <init-param>
            <param-name>filterMappingUrlPattern</param-name>
            <param-value>/*</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>WicketFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
